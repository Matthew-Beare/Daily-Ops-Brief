{
  "schema_version": 1,
  "product_name": "M.I.R.R.O.R.",
  "brand_product_name": "MIRROR",
  "assistant_default_name": "MIRA",
  "canonical_source": {
    "channel_id": "personal-production",
    "repository": "Matthew-Beare/MIRA-Personal-Production",
    "brand_repository": "Matthew-Beare/MIRA-Personal-Production",
    "display_name": "M.I.R.R.O.R. Personal-Production",
    "required_visibility": "public",
    "role": "sole-source-of-truth",
    "template_repository": false
  },
  "portable_paths": [
    ".gitignore",
    "LICENSE",
    "docs/BRANDING.md",
    "privacy/starter-blocklist.txt",
    "scripts/audit_public_source.py",
    "scripts/audit_starter_privacy.py",
    "scripts/validate_distribution.py",
    "starter"
  ],
  "forbidden_distribution_roots": [
    "distribution",
    "policy",
    "project",
    "skill",
    "tests"
  ],
  "channels": [
    {
      "channel_id": "public-experimental",
      "display_name": "M.I.R.R.O.R. Personal-Experimental",
      "repository": "Matthew-Beare/MIRA-Public-Experimental",
      "brand_repository": "Matthew-Beare/MIRA-Public-Experimental",
      "required_visibility": "public",
      "template_repository": true,
      "overlay": "distribution/overlays/public-experimental",
      "allowed_runtime_data": [
        "public",
        "synthetic"
      ],
      "regulated_data_allowed_in_git": false
    },
    {
      "channel_id": "institutional-experimental",
      "display_name": "M.I.R.R.O.R. Institutional-Experimental",
      "repository": "Matthew-Beare/MIRA-Institutional-Experimental",
      "brand_repository": "Matthew-Beare/MIRA-Institutional-Experimental",
      "required_visibility": "public",
      "template_repository": false,
      "overlay": "distribution/overlays/institutional-experimental",
      "allowed_runtime_data": [
        "public",
        "synthetic",
        "organization-approved-runtime-only"
      ],
      "regulated_data_allowed_in_git": false
    }
  ],
  "shared_code_contract": {
    "same_portable_source_revision_required": true,
    "channel_specific_feature_code_allowed": false,
    "allowed_channel_differences": [
      "deployment-policy",
      "approved-runtime-provider-config",
      "data-classification",
      "mutable-external-state"
    ]
  },
  "promotion_contract": {
    "distribution_repositories_are_sources_of_truth": false,
    "manual_edits_to_distribution_repositories_allowed": false,
    "source_revision_required": true,
    "validation_required_before_publish": true,
    "remote_readback_required": true,
    "green_ci_required": true,
    "force_push_allowed": false
  }
}
