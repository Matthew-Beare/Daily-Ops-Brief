# mirror service customer deployment template.
# Copy to a local .env file. Never commit the populated file.

MIRROR_AUTH_MODE=required
MIRROR_ACCESS_TOKEN=
MIRROR_TOKEN_KEY=
MIRROR_DEFAULT_PROVIDER=google_workspace
MIRROR_EVIDENCE_PROVIDER=auto
MIRROR_PUBLIC_BASE_URL=http://localhost:8765
MIRROR_CORS_ORIGINS=http://localhost:8765,http://127.0.0.1:8765,http://tauri.localhost,https://tauri.localhost,tauri://localhost,https://appassets.androidplatform.net,null
MIRROR_MAX_EVIDENCE_BYTES=104857600

# Google Workspace is the default provider. Create an OAuth web client for the deployment,
# register the exact callback URL below, and enable only APIs used by selected capabilities.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8765/v1/auth/google/callback
GOOGLE_DRIVE_FOLDER_ID=

# Optional Microsoft 365 alternative.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:8765/v1/auth/microsoft/callback

# Optional Home Assistant adapter. These are server-side HA credentials, not OpenAI/API billing credentials.
# Prefer a narrowly scoped dedicated HA identity/token when the deployment supports one.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# Storage portability: the current starter runtime is SQLite on one service node.
# PostgreSQL and SQL Server are defined adapter targets but are not silently enabled by setting a DSN yet.
MIRROR_STRUCTURED_STATE_PROVIDER=sqlite
