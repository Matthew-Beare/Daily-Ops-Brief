{
  "manifest_version": 1,
  "id": "meal-planning",
  "version": "0.2.0-beta.1",
  "summary": "Adaptive meal, recipe, leftover and grocery-intent planning with private Git-backed personal state and accessible-history import.",
  "portable": true,
  "compatibility": {"core": ">=0.1.0-beta.1"},
  "dependencies": [],
  "entrypoints": {
    "references": ["FEATURE.md"],
    "scripts": [],
    "schemas": [],
    "migrations": []
  },
  "permissions": {
    "connectors": [],
    "network_domains": [],
    "writes": ["private Git meal/recipe state", "active shopping intent when enabled"],
    "approval_required": ["initial provisioning", "external purchase/contact", "public feature contribution"]
  },
  "data_boundary": {
    "source_contains_personal_data": false,
    "shared_logs_contain_personal_data": false,
    "runtime_state": "deployment-local",
    "forbidden_source_data": ["credentials", "private deployment state", "medical records", "private chat transcripts", "private evidence references"]
  },
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {"type": "boolean"},
      "state_namespace": {"type": "string"},
      "shopping_intent_enabled": {"type": "boolean"},
      "planning_horizon_days": {"type": "integer"},
      "existing_material_import": {"type": "boolean"}
    }
  },
  "tests": ["tests/contract.md"]
}