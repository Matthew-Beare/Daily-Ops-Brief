# Default personal lane: Google Workspace is the canonical state/evidence provider.
MIRROR_PUBLIC_BASE_URL=http://localhost:8080
MIRROR_BIND=127.0.0.1
MIRROR_PORT=8080
MIRROR_PROVIDER_DEFAULT=google
MIRROR_STATE_BACKEND=google

# Create an OAuth 2.0 Web application in Google Cloud Console.
# Redirect URI: <MIRROR_PUBLIC_BASE_URL>/auth/google/callback
MIRROR_GOOGLE_CLIENT_ID=
MIRROR_GOOGLE_CLIENT_SECRET=

# Generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MIRROR_TOKEN_ENCRYPTION_KEY=

# true only behind HTTPS.
MIRROR_SESSION_SECURE=false

# Optional SQL lane. When MIRROR_STATE_BACKEND=postgres, set a DSN.
MIRROR_POSTGRES_DSN=postgresql://mirror:password@postgres:5432/mirror
MIRROR_POSTGRES_PASSWORD=
